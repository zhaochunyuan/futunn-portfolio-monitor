# ===== 富途组合 ID =====
# 在富途 APP 的社区模拟组合分享链接里找 portfolio_id
PORTFOLIO_IDS=154216,167429,108131

# ===== 推送通道（至少配置一个；两个都配则同时推送）=====

# 【钉钉】加签模式
# 创建：钉钉群 -> 群设置 -> 智能群助手 -> 添加自定义机器人 -> 安全设置选"加签"
DINGTALK_WEBHOOK=
DINGTALK_SECRET=

# 【Discord】Webhook
# 创建：Discord 服务器 -> 频道设置 -> 整合 -> Webhook -> 新 Webhook -> 复制 URL
# 注意：中国大陆服务器无法访问 Discord，需要海外/香港 IP
DISCORD_WEBHOOK=

# ===== 轮询配置 =====
# 检查间隔（秒），建议 30-60，太快易被风控
CHECK_INTERVAL=36
# 权重变化阈值（百分点），低于此值的变动不推送。新增/清仓始终推送
CHANGE_THRESHOLD=2.0
