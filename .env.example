# 富途组合 ID 列表，逗号分隔
# 在富途 APP 的社区模拟组合分享链接里找 portfolio_id
PORTFOLIO_IDS=154216,167429,108131

# 钉钉机器人 Webhook（加签模式）
# 创建方式：钉钉群 -> 群设置 -> 智能群助手 -> 添加自定义机器人 -> 安全设置选"加签"
DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=YOUR_ACCESS_TOKEN
DINGTALK_SECRET=SECYOUR_SECRET

# 检查间隔（秒），建议 30-60，太快易被风控
CHECK_INTERVAL=36

# 权重变化阈值（百分点），低于此值的变动不推送。新增/清仓始终推送
CHANGE_THRESHOLD=2.0
